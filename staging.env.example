# Copy to .env.staging, then use docker compose --env-file .env.staging ...
SERVERNAME=BadLads-Staging-EU
STEAMCMD_BETA=staging
STEAMCMD_BETA_PASSWORD=
STEAMCMD_LOGIN=anonymous
STEAMCMD_SKIP=false
STEAMCMD_NO_VALIDATE=true
USER_UID=1000
USER_GID=1000
BADLADS_DATA_DIR=./data-staging
BADLADS_ARGS=-log -useperfthreads
